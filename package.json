{
  "name": "emotion-checkin",
  "version": "0.1.0",
  "private": true,
  "description": "1日数回の絵文字感情記録 + 週次保護者通知 (Chrome Extension, Manifest V3)",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "tsc --noEmit",
    "check:emoji-picker": "node scripts/check-emoji-picker.mjs",
    "check:daily-prompt": "node scripts/check-daily-prompt.mjs",
    "check:weekly-summary": "node scripts/check-weekly-summary.mjs",
    "check:parent-share": "node scripts/check-parent-share.mjs",
    "check:calendar-view": "node scripts/check-calendar-view.mjs",
    "check": "npm run lint && npm run check:emoji-picker && npm run check:daily-prompt && npm run check:weekly-summary && npm run check:parent-share && npm run check:calendar-view",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
